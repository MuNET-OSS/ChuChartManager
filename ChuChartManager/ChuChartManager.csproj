<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsTransformWebConfigDisabled>True</IsTransformWebConfigDisabled>
    <StaticWebAssetsEnabled>True</StaticWebAssetsEnabled>
    <StartupObject>ChuChartManager.Program</StartupObject>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <InvariantGlobalization>false</InvariantGlobalization>
    <NoWarn>NU1605</NoWarn>
    <CETCompat>false</CETCompat>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\LICENSE">
	  <Link>LICENSE</Link>
	  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="icon.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Include="tools\ugctool.exe" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\template_music.acb" CopyToOutputDirectory="PreserveNewest" />
<Content Include="Resources\AppleChu\*.toml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\FreeMote\FreeMote.Tools.Viewer\bin\Release\net48\**" Link="tools\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\FreeMote\FreeMote.Tools.PsbDecompile\bin\Release\net48\**" Link="tools\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\FreeMote\FreeMote.Tools.PsBuild\bin\Release\net48\**" Link="tools\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BCnEncoder.Net.ImageSharp" Version="1.1.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3856.49" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="NAudio.Lame" Version="2.1.0" />
    <PackageReference Include="Pfim" Version="0.11.4" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="Tomlyn" Version="2.4.0" />
    <PackageReference Include="YAXLib" Version="2.15.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SonicAudioTools\Source\SonicAudioLib\SonicAudioLib.csproj" />
    <ProjectReference Include="..\MuConvert\MuConvert.csproj">
      <ExcludeAssets>all</ExcludeAssets>
      <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\XV2-Tools\LB_Common\LB_Common.csproj">
      <Aliases>global,LBCommon</Aliases>
    </ProjectReference>
    <ProjectReference Include="..\XV2-Tools\Xv2CoreLib\Xv2CoreLib.csproj" />
    <ProjectReference Include="..\DDSExtractor\DDSExtractor\DDSExtractor.vbproj">
      <ExcludeAssets>all</ExcludeAssets>
      <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Front\**" />
    <Content Remove="Front\**" />
    <None Remove="Front\**" />
    <Compile Remove="App.xaml.cs" />
    <Compile Remove="MainWindow.xaml.cs" />
    <Compile Remove="StartupWindow.xaml.cs" />
    <Compile Remove="WebPreviewWindow.xaml.cs" />
    <Compile Remove="DwmHelper.cs" />
    <Compile Remove="Models\DiffBadge.cs" />
    <Compile Remove="Models\MusicRow.cs" />
    <Compile Remove="Models\DifficultyItem.cs" />
    <Page Remove="**\*.xaml" />
    <ApplicationDefinition Remove="App.xaml" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="icon.ico" />
  </ItemGroup>
</Project>

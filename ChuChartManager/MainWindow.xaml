<Window
    x:Class="ChuChartManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ChuChartManager"
    Title="ChuChartManager"
    Width="1300" Height="820"
    MinWidth="900" MinHeight="550"
    WindowStartupLocation="CenterScreen"
    Background="Transparent"
    WindowStyle="SingleBorderWindow">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" GlassFrameThickness="-1" CornerRadius="0" ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>

    <Grid Background="#05FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="Transparent">
            <TextBlock Text="ChuChartManager" FontSize="12" FontWeight="SemiBold" Margin="14,0,0,0"
                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="320" MaxWidth="500"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧列表 -->
            <Grid Grid.Column="0" Margin="12,4,0,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 筛选栏：Option + 流派 并排 -->
                <Grid Grid.Row="0" Margin="0,4,8,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" x:Name="SourceSelector"
                              SelectionChanged="SourceSelector_Changed"
                              Style="{StaticResource DarkComboBox}" Margin="0,0,3,0"/>
                    <ComboBox Grid.Column="1" x:Name="GenreFilter"
                              SelectionChanged="GenreFilter_Changed"
                              Style="{StaticResource DarkComboBox}" Margin="3,0,0,0"/>
                </Grid>

                <!-- 难度分类筛选 -->
                <ComboBox Grid.Row="1" x:Name="DiffFilter"
                          SelectionChanged="DiffFilter_Changed"
                          HorizontalAlignment="Stretch" Margin="0,2,8,6"
                          Style="{StaticResource DarkComboBox}"/>

                <ListBox Grid.Row="2"
                         x:Name="MusicListBox"
                         SelectionChanged="MusicListBox_SelectionChanged"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         ItemContainerStyle="{StaticResource CardListBoxItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:MusicRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" CornerRadius="10" ClipToBounds="True"
                                        Width="58" Height="58" Background="#18181C">
                                    <Image Source="{Binding JacketSource}" Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding IdDisplay}" FontSize="9.5" Opacity="0.45"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" Margin="0,1,0,4"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <ItemsControl ItemsSource="{Binding Badges}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:DiffBadge}">
                                                <Border CornerRadius="10" Padding="7,2.5" Margin="0,0,4,0"
                                                        Background="{Binding BgBrush}">
                                                    <TextBlock Text="{Binding Level, Mode=OneTime}"
                                                               FontSize="10" FontWeight="Bold"
                                                               Foreground="{Binding FgBrush}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <Button Grid.Column="2" Tag="{Binding}" Click="OnCardPlay"
                                        Width="30" Height="30" Padding="0"
                                        Style="{StaticResource RoundButton}"
                                        Background="#2A2A30"
                                        VerticalAlignment="Center" Margin="4,0,0,0">
                                    <Path Width="10" Height="10"
                                          Data="M 0,0 L 10,5 L 0,10 Z"
                                          Fill="{StaticResource TextPrimaryBrush}" Stretch="Uniform"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" Margin="0,12"/>

            <!-- 右侧详情 -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="8,4,12,8">
                <StackPanel x:Name="DetailPanel" Margin="4" Visibility="Collapsed">

                    <Border x:Name="JacketBorder" CornerRadius="14" Width="200" Height="200"
                            HorizontalAlignment="Left" Background="#18181C" ClipToBounds="True">
                        <Image x:Name="JacketImage" Stretch="UniformToFill"/>
                    </Border>

                    <TextBlock Text="歌曲名称" FontSize="10" Margin="0,16,0,4"
                               Foreground="{StaticResource TextTertiaryBrush}"/>
                    <TextBox x:Name="TxtName" Style="{StaticResource DarkTextBox}" TextChanged="OnFieldChanged"/>

                    <TextBlock Text="作者" FontSize="10" Margin="0,10,0,4"
                               Foreground="{StaticResource TextTertiaryBrush}"/>
                    <TextBox x:Name="TxtArtist" Style="{StaticResource DarkTextBox}" TextChanged="OnFieldChanged"/>

                    <TextBlock Text="BPM" FontSize="10" Margin="0,10,0,4"
                               Foreground="{StaticResource TextTertiaryBrush}"/>
                    <TextBox x:Name="TxtBpm" Style="{StaticResource DarkTextBox}" TextChanged="OnFieldChanged"/>

                    <TextBlock Text="流派" FontSize="10" Margin="0,10,0,4"
                               Foreground="{StaticResource TextTertiaryBrush}"/>
                    <ComboBox x:Name="CmbGenre" Style="{StaticResource DarkComboBox}"
                              SelectionChanged="OnGenreChanged"/>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16,0,14" Opacity="0.5"/>

                    <!-- 难度标签栏 -->
                    <StackPanel x:Name="DiffTabBar" Orientation="Horizontal" Margin="0,0,0,0"/>

                    <!-- 难度详情面板 -->
                    <Border x:Name="DiffDetailBorder" CornerRadius="0,8,8,8" Padding="14,12"
                            Background="{StaticResource CardBrush}" Visibility="Collapsed">
                        <StackPanel>
                            <!-- 启用 -->
                            <Grid Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="启用" FontSize="11" Margin="0,0,10,0"
                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="ChkDiffEnabled" Style="{StaticResource ToggleSwitch}"
                                              Checked="OnDiffCheckChanged" Unchecked="OnDiffCheckChanged"/>
                                </StackPanel>
                            </Grid>

                            <!-- 作者 -->
                            <TextBlock Text="作者" FontSize="10" Margin="0,4,0,4"
                                       Foreground="{StaticResource TextTertiaryBrush}"/>
                            <TextBox x:Name="TxtDiffDesigner" Style="{StaticResource DarkTextBox}" FontSize="11"
                                     TextChanged="OnDiffTextChanged"/>

                            <!-- 显示等级 -->
                            <TextBlock Text="显示等级" FontSize="10" Margin="0,8,0,4"
                                       Foreground="{StaticResource TextTertiaryBrush}"/>
                            <TextBox x:Name="TxtDiffLevel" Style="{StaticResource DarkTextBox}" FontSize="11"
                                     TextChanged="OnDiffTextChanged"/>

                            <!-- 定数 -->
                            <TextBlock Text="定数" FontSize="10" Margin="0,8,0,4"
                                       Foreground="{StaticResource TextTertiaryBrush}"/>
                            <TextBox x:Name="TxtDiffConst" Style="{StaticResource DarkTextBox}" FontSize="11"
                                     IsReadOnly="True"/>

                            <!-- 音符数量 -->
                            <TextBlock Text="音符数量" FontSize="10" Margin="0,8,0,4"
                                       Foreground="{StaticResource TextTertiaryBrush}"/>
                            <TextBox x:Name="TxtNoteCount" Style="{StaticResource DarkTextBox}" FontSize="11"
                                     IsReadOnly="True"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="BtnSave" Content="保存修改" Style="{StaticResource RoundButton}"
                                Padding="20,8" FontSize="12" Visibility="Collapsed" Click="OnSave"/>
                        <Button Content="导出 MP3" Style="{StaticResource RoundButton}"
                                Padding="16,8" FontSize="12" Click="OnExportMp3" Margin="8,0,0,0"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 底部播放器 -->
        <Border Grid.Row="2" Background="#18181C" Padding="10,8" BorderThickness="0,1,0,0"
                BorderBrush="{StaticResource BorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 封面缩略图 -->
                <Border Grid.Column="0" CornerRadius="6" ClipToBounds="True"
                        Width="40" Height="40" Background="#28282E" Margin="0,0,10,0">
                    <Image x:Name="PlayerJacket" Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <!-- 歌曲信息 -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0" MaxWidth="180">
                    <TextBlock x:Name="TxtPlayerName" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtPlayerArtist" FontSize="10"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                </StackPanel>

                <!-- 播放/暂停 -->
                <Button x:Name="BtnPlayPause" Grid.Column="2" Width="36" Height="36"
                        Style="{StaticResource RoundButton}" Click="OnPlayPause"
                        VerticalAlignment="Center" Margin="0,0,4,0" Padding="0">
                    <Path x:Name="PlayPauseIcon" Fill="{StaticResource TextPrimaryBrush}"
                          Stretch="Uniform" Width="14" Height="14"
                          Data="M 0,0 L 14,7 L 0,14 Z"/>
                </Button>

                <!-- 停止 -->
                <Button x:Name="BtnStop" Grid.Column="3" Width="32" Height="32"
                        Style="{StaticResource RoundButton}" Click="OnStop"
                        VerticalAlignment="Center" Margin="0,0,12,0" Padding="0">
                    <Rectangle Width="11" Height="11" Fill="{StaticResource TextPrimaryBrush}"
                               RadiusX="1.5" RadiusY="1.5"/>
                </Button>

                <!-- 当前时间 -->
                <TextBlock x:Name="TxtCurrentTime" Grid.Column="4" FontSize="10" FontFamily="Consolas"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0"
                           Text="00:00"/>

                <!-- 进度条 -->
                <Slider x:Name="SliderProgress" Grid.Column="5" Style="{StaticResource DarkSlider}"
                        Minimum="0" Maximum="1000"
                        PreviewMouseLeftButtonDown="OnProgressDragStart"
                        PreviewMouseLeftButtonUp="OnProgressDragEnd"
                        ValueChanged="OnProgressChanged"
                        IsMoveToPointEnabled="True" Cursor="Hand"
                        VerticalAlignment="Center"/>

                <!-- 总时间 -->
                <TextBlock x:Name="TxtTotalTime" Grid.Column="6" FontSize="10" FontFamily="Consolas"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           VerticalAlignment="Center" Margin="8,0,14,0"
                           Text="00:00"/>

                <!-- 音量图标 -->
                <TextBlock Grid.Column="7" Text="🔊" FontSize="12" VerticalAlignment="Center"
                           Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,4,0"/>

                <!-- 音量滑块 -->
                <Slider x:Name="SliderVolume" Grid.Column="8" Style="{StaticResource VolumeSlider}"
                        VerticalAlignment="Center"
                        ValueChanged="OnVolumeChanged"/>
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="2" Text="" FontSize="9"
                   Foreground="{StaticResource TextTertiaryBrush}"
                   VerticalAlignment="Bottom" HorizontalAlignment="Left"
                   Margin="14,0,0,2" IsHitTestVisible="False" Opacity="0.5"/>
    </Grid>
</Window>
